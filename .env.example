# Supabase Postgres — Transaction pooler (puerto 6543). Dashboard → Connect → Transaction.
# Prisma Client usa esta URL en runtime (Vercel / serverless).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa / Session pooler (puerto 5432). Dashboard → Connect → Session o Direct.
# Prisma CLI la usa para `db push` y migraciones.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Proyecto de Supabase (Settings → API).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
# Service role: solo servidor. Sube fotos a Storage y crea el bucket `platos`.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="YOUR_AUTH_SECRET_CHANGE_ME"
# Optional. With trustHost, Auth.js uses the request host.
# AUTH_URL="http://localhost:3000"

# Demo users created by prisma/seed.ts
# ADMIN     admin@vistadelvalle.local     / ValleAdmin2026
# CAMARERO  camarero@vistadelvalle.local  / ValleCamarero2026
# COCINA    cocina@vistadelvalle.local    / ValleCocina2026

# Optional local Postgres (docker compose) if you are not using a hosted Supabase project:
# DATABASE_URL="postgresql://vista:vista@localhost:5433/vistadelvalle?schema=public"
# DIRECT_URL="postgresql://vista:vista@localhost:5433/vistadelvalle?schema=public"
