# Supabase project: Vista del Valle (tdoeqgyxjdpxmghuirox, us-west-2)
# Replace YOUR-PASSWORD with the database password from Project Settings → Database.

# Transaction pooler (IPv4). Prisma Client / the Next.js app on Vercel.
DATABASE_URL="postgresql://postgres.tdoeqgyxjdpxmghuirox:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler. Prisma CLI (`db push`, seed).
DIRECT_URL="postgresql://postgres.tdoeqgyxjdpxmghuirox:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://tdoeqgyxjdpxmghuirox.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"
# Service role: solo servidor. Sube fotos y crea el bucket `platos`.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="YOUR_AUTH_SECRET_CHANGE_ME"
# Optional. With trustHost, Auth.js uses the request host.
# AUTH_URL="http://localhost:3000"

# Demo users created by prisma/seed.ts
# ADMIN     admin@vistadelvalle.local     / ValleAdmin2026
