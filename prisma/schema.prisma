generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CAMARERO
  COCINA
}

enum CategoryType {
  COMIDA
  BEBIDA
}

enum Turno {
  DESAYUNO
  ALMUERZO
  CENA
}

enum UnidadMedida {
  G
  ML
  UD
}

enum MovementType {
  ENTRADA
  VENTA
  AJUSTE
  PREPARACION
}

enum InventoryAuditAccion {
  ALTA
  BAJA
  RENOMBRE
  RESET
}

model User {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  passwordHash String
  role         Role
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  movements    InventoryMovement[]
  saleItems    SaleItem[]
  audits       InventoryAudit[]
  prepBatches  PrepBatch[]
}

model Category {
  id        String       @id
  nombre    String
  tipo      CategoryType
  esInterna Boolean      @default(false)
  orden     Int          @default(0)
  dishes    Dish[]
}

model Dish {
  id                String     @id
  nombre            String
  descripcion       String?
  precio            Decimal?
  foto              String?
  categoryId        String
  category          Category   @relation(fields: [categoryId], references: [id])
  disponible        Boolean    @default(true)
  destacado         Boolean    @default(false)
  incluyeGuarnicion Boolean    @default(false)
  recipe            Recipe?
  saleItems         SaleItem[]
  garnishItems      SaleItem[] @relation("Garnish")
}

model Ingredient {
  id               String               @id
  nombre           String               @unique
  unidadMedida     UnidadMedida
  unidadEtiqueta   String               @default("")
  contenidoPorItem Decimal              @default(1)
  tipoMinimo       String?
  stockActual      Decimal
  stockMinimo      Decimal
  recipeItems      RecipeIngredient[]
  movements        InventoryMovement[]
  prepOutputOf     PrepRecipe?
  prepItems        PrepRecipeIngredient[]
}

model Recipe {
  id                String             @id @default(cuid())
  dishId            String             @unique
  dish              Dish               @relation(fields: [dishId], references: [id], onDelete: Cascade)
  porcionesQueRinde Int                @default(1)
  tiempoPreparacion Int?
  pasos             Json
  ingredients       RecipeIngredient[]
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  cantidad     Decimal
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([recipeId, ingredientId])
}

model PrepRecipe {
  id                 String                 @id @default(cuid())
  nombre             String
  outputIngredientId String                 @unique
  outputIngredient   Ingredient             @relation(fields: [outputIngredientId], references: [id], onDelete: Restrict)
  rendimiento        Decimal
  tiempoPreparacion  Int?
  pasos              Json
  ingredients        PrepRecipeIngredient[]
  batches            PrepBatch[]
}

model PrepRecipeIngredient {
  recipeId     String
  ingredientId String
  cantidad     Decimal
  recipe       PrepRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([recipeId, ingredientId])
}

model PrepBatch {
  id        String              @id @default(cuid())
  recipeId  String
  recipe    PrepRecipe          @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  lotes     Decimal
  fecha     DateTime
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  anulado   Boolean             @default(false)
  createdAt DateTime            @default(now())
  movements InventoryMovement[]
}

model Sale {
  id        String     @id @default(cuid())
  fecha     DateTime
  turno     Turno
  items     SaleItem[]
  createdAt DateTime   @default(now())

  @@unique([fecha, turno])
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  dishId         String
  dish           Dish     @relation(fields: [dishId], references: [id])
  cantidad       Int
  precioUnitario Decimal
  garnishId      String?
  garnish        Dish?    @relation("Garnish", fields: [garnishId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
}

model InventoryMovement {
  id           String       @id @default(cuid())
  ingredientId String
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  tipo         MovementType
  cantidad     Decimal
  precioTotal  Decimal?
  nota         String?
  fecha        DateTime     @default(now())
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  prepBatchId  String?
  prepBatch    PrepBatch?   @relation(fields: [prepBatchId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
}

model InventoryAudit {
  id        String               @id @default(cuid())
  accion    InventoryAuditAccion
  nombre    String
  detalle   String?
  userId    String?
  user      User?                @relation(fields: [userId], references: [id])
  createdAt DateTime             @default(now())
}
